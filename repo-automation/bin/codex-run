#!/usr/bin/env bash
# repo-automation/bin/codex-run

set -u
set -o pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
. "$script_dir/../lib/common.sh" || {
  printf 'STOP: failed to source shared library\n' >&2
  return 2 2>/dev/null || exit 2
}

# shellcheck source=/dev/null
. "$script_dir/../lib/operator-output.sh" || {
  printf 'STOP: failed to source operator output library\n' >&2
  return 2 2>/dev/null || exit 2
}

codex_run_quiet=0
codex_run_explain=0
codex_run_json=0
codex_run_prompt_file=""
codex_run_resume_session_id=""
codex_run_out_dir=""
codex_run_out_dir_abs=""
codex_run_profile="default"
codex_run_model=""
codex_run_reasoning=""
codex_run_cd=""
codex_run_cd_abs=""
codex_run_sandbox="workspace-write"
codex_run_timeout="0"
codex_run_timeout_enforced="not_requested"
codex_run_repo_root=""
codex_run_codex_path=""
codex_run_stdout_path=""
codex_run_stderr_path=""
codex_run_final_output_path=""
codex_run_final_output_block_path=""
codex_run_summary_path=""
codex_run_exit_code=0
codex_run_result="pass"
codex_run_final_output_status="missing"
codex_run_elapsed_seconds=""
codex_run_elapsed_summary="unknown"
codex_run_failure_step=""
codex_run_failure_code=""
codex_run_failure_reason=""
codex_run_failure_fix=""
codex_run_failure_log=""
codex_run_failure_excerpt=""
codex_run_failure_artifact=""

codex_run_usage() {
  printf 'Usage: repo-automation/bin/codex-run --prompt-file=<path> --out-dir=<path> [--resume-session-id=<id>] [--profile=<name>] [--model=<model-name>] [--reasoning=<low|medium|high>] [--cd=<path>] [--sandbox=<mode>] [--timeout=<seconds>] [--quiet] [--explain] [--help]\n'
}

codex_run_fail() {
  printf 'fail: %s\n' "$1" >&2
  printf 'fix: %s\n' "$2" >&2
}

codex_run_flag_value_error() {
  local reason="$1"
  local flag="$2"
  local fix="$3"

  repo_auto_flag_error "$reason" "$flag" "$fix" || true
}

codex_run_is_conservative_token() {
  case "${1:-}" in
    ''|[-]*|*[!A-Za-z0-9._-]*)
      return 1
      ;;
  esac

  return 0
}

codex_run_is_conservative_session_id() {
  codex_run_is_conservative_token "$1"
}

codex_run_is_reasoning_level() {
  case "${1:-}" in
    low|medium|high)
      return 0
      ;;
  esac
  return 1
}

codex_run_format_elapsed_summary() {
  local total_seconds="${1:-}"
  local hours=0
  local minutes=0
  local seconds=0
  local parts=()

  case "$total_seconds" in
    ''|*[!0-9]*)
      printf '%s' unknown
      return 0
      ;;
  esac

  hours=$((total_seconds / 3600))
  minutes=$(((total_seconds % 3600) / 60))
  seconds=$((total_seconds % 60))

  if [ "$hours" -gt 0 ]; then
    parts+=("${hours}h")
  fi
  if [ "$minutes" -gt 0 ]; then
    parts+=("${minutes}m")
  fi
  parts+=("${seconds}s")

  printf '%s' "${parts[*]}"
}

codex_run_resolve_existing_dir() {
  local input_path="$1"
  local resolved_path=""

  resolved_path="$(
    python3 - "$input_path" <<'PY'
from pathlib import Path
import sys

path = Path(sys.argv[1]).expanduser()
try:
    resolved = path.resolve(strict=True)
except OSError as exc:
    print(f"fail: path does not exist or is not accessible: {path}", file=sys.stderr)
    print("fix: provide an existing directory path", file=sys.stderr)
    raise SystemExit(1)

if not resolved.is_dir():
    print(f"fail: path is not a directory: {resolved}", file=sys.stderr)
    print("fix: provide an existing directory path", file=sys.stderr)
    raise SystemExit(1)

print(resolved)
PY
  )" || return 1

  printf '%s\n' "$resolved_path"
}

codex_run_resolve_out_dir() {
  local input_path="$1"
  local repo_root="$2"
  local resolved_path=""

  resolved_path="$(
    python3 - "$input_path" "$repo_root" <<'PY'
from pathlib import Path
import sys

out_dir = Path(sys.argv[1]).expanduser().resolve(strict=False)
repo_root = Path(sys.argv[2]).resolve(strict=True)

try:
    out_dir.relative_to(repo_root)
except ValueError:
    pass
else:
    print('fail: out-dir must be outside the repo root', file=sys.stderr)
    print('fix: choose a directory outside the current repo root', file=sys.stderr)
    raise SystemExit(1)

print(out_dir)
PY
  )" || return 1

  printf '%s\n' "$resolved_path"
}

codex_run_first_excerpt() {
  local path="$1"

  if [ -f "$path" ] && [ -s "$path" ]; then
    awk 'NF { print; count++; if (count == 8) exit }' "$path"
    return 0
  fi

  printf '(no output)\n'
}

codex_run_first_excerpt_line() {
  local path="$1"

  if [ -f "$path" ] && [ -s "$path" ]; then
    awk 'NF { print; exit }' "$path"
    return 0
  fi

  printf '(no output)\n'
}

codex_run_write_summary() {
  {
    cat <<EOF
script=codex-run
result=$codex_run_result
exit_code=$codex_run_exit_code
prompt_file=$codex_run_prompt_file
resume_mode=$([ -n "$codex_run_resume_session_id" ] && printf 'resume' || printf 'fresh')
resume_session_id=$codex_run_resume_session_id
out_dir=$codex_run_out_dir_abs
EOF
    if [ -n "$codex_run_resume_session_id" ]; then
      printf 'resume_workdir=%s\n' "$codex_run_cd_abs"
      printf 'requested_profile=%s\n' "$codex_run_profile"
      printf 'requested_sandbox=%s\n' "$codex_run_sandbox"
    else
      printf 'cd=%s\n' "$codex_run_cd_abs"
      printf 'profile=%s\n' "$codex_run_profile"
      printf 'sandbox=%s\n' "$codex_run_sandbox"
    fi
    if [ -n "$codex_run_model" ]; then
      printf 'requested_model=%s\n' "$codex_run_model"
    fi
    if [ -n "$codex_run_reasoning" ]; then
      printf 'requested_reasoning=%s\n' "$codex_run_reasoning"
    fi
    cat <<EOF
timeout=$codex_run_timeout
timeout_enforced=$codex_run_timeout_enforced
codex_path=$codex_run_codex_path
stdout_path=$codex_run_stdout_path
stderr_path=$codex_run_stderr_path
final_output_path=$codex_run_final_output_path
final_output_status=$codex_run_final_output_status
EOF
    if [ -n "$codex_run_failure_step" ]; then
      printf 'failure_step=%s\n' "$codex_run_failure_step"
    fi
    if [ -n "$codex_run_failure_code" ]; then
      printf 'failure_code=%s\n' "$codex_run_failure_code"
    fi
    if [ -n "$codex_run_failure_reason" ]; then
      printf 'failure_reason=%s\n' "$codex_run_failure_reason"
    fi
    if [ -n "$codex_run_failure_fix" ]; then
      printf 'failure_fix=%s\n' "$codex_run_failure_fix"
    fi
    if [ -n "$codex_run_failure_log" ]; then
      printf 'failure_log=%s\n' "$codex_run_failure_log"
    fi
    if [ -n "$codex_run_failure_artifact" ]; then
      printf 'failure_artifact=%s\n' "$codex_run_failure_artifact"
    fi
    if [ -n "$codex_run_failure_excerpt" ]; then
      printf 'failure_excerpt=%s\n' "$codex_run_failure_excerpt"
    fi
    if [ -n "$codex_run_final_output_block_path" ] && [ -f "$codex_run_final_output_block_path" ]; then
      printf 'codex_final_output_block_path=%s\n' "$codex_run_final_output_block_path"
    fi
    if [ -n "$codex_run_elapsed_seconds" ]; then
      printf 'elapsed_seconds=%s\n' "$codex_run_elapsed_seconds"
      printf 'elapsed=%s\n' "$codex_run_elapsed_summary"
    fi
  } > "$codex_run_summary_path"
}

codex_run_print_final_summary() {
  local rc="$1"
  local final_output_value="$2"
  local summary_value="$3"
  local status_value="$4"

  printf '===== FINAL SUMMARY =====\n'
  printf 'script=codex-run\n'
  printf 'mode=run\n'
  printf 'rc=%s\n' "$rc"
  if [ -n "$codex_run_resume_session_id" ]; then
    printf 'resume_workdir=%s\n' "$codex_run_cd_abs"
    printf 'requested_profile=%s\n' "$codex_run_profile"
    printf 'requested_sandbox=%s\n' "$codex_run_sandbox"
  else
    printf 'profile=%s\n' "$codex_run_profile"
    printf 'sandbox=%s\n' "$codex_run_sandbox"
  fi
  if [ -n "$codex_run_model" ]; then
    printf 'requested_model=%s\n' "$codex_run_model"
  fi
  if [ -n "$codex_run_reasoning" ]; then
    printf 'requested_reasoning=%s\n' "$codex_run_reasoning"
  fi
  printf 'final_output=%s\n' "$final_output_value"
  printf 'summary=%s\n' "$summary_value"
  printf 'status=%s\n' "$status_value"
  printf '===== END =====\n'
}

codex_run_print_failure_block() {
  local step="$1"
  local exit_code="$2"
  local reason="$3"
  local log_path="$4"
  local artifact_path="$5"
  local excerpt_text="$6"
  local fix="$7"

  printf 'fail: codex-run failed\n'
  printf 'step: %s\n' "$step"
  printf 'exit_code: %s\n' "$exit_code"
  printf 'reason: %s\n' "$reason"
  printf 'excerpt:\n'
  printf '%s\n' "$excerpt_text"
  if [ -n "$log_path" ]; then
    printf 'log: %s\n' "$log_path"
  elif [ -n "$artifact_path" ]; then
    printf 'artifact: %s\n' "$artifact_path"
  fi
  printf 'fix: %s\n' "$fix"
}

codex_run_print_quiet_failure() {
  local code="$1"
  local step="$2"
  local reason="$3"
  local fix="$4"
  local log_path="$5"
  local artifact_path="$6"
  local excerpt_text="$7"

  printf 'result=fail\n'
  printf 'code=%s\n' "$code"
  printf 'step=%s\n' "$step"
  printf 'reason=%s\n' "$reason"
  printf 'fix=%s\n' "$fix"
  if [ -n "$log_path" ]; then
    printf 'log=%s\n' "$log_path"
  fi
  if [ -n "$artifact_path" ]; then
    printf 'artifact=%s\n' "$artifact_path"
  fi
  if [ -n "$excerpt_text" ]; then
    printf 'excerpt=%s\n' "$excerpt_text"
  fi
}

codex_run_finish_failure() {
  local quiet_code="$1"
  local step="$2"
  local reason="$3"
  local fix="$4"
  local exit_code="$5"
  local log_path="$6"
  local artifact_path="$7"
  local excerpt_text="$8"

  codex_run_result="fail"
  codex_run_failure_step="$step"
  codex_run_failure_code="$quiet_code"
  codex_run_failure_reason="$reason"
  codex_run_failure_fix="$fix"
  codex_run_failure_log="$log_path"
  codex_run_failure_artifact="$artifact_path"
  codex_run_failure_excerpt="$excerpt_text"
  codex_run_write_summary || return 1

  if [ "$codex_run_quiet" -eq 1 ]; then
    codex_run_print_quiet_failure "$quiet_code" "$step" "$reason" "$fix" "$log_path" "$artifact_path" "$excerpt_text" >&2
  else
      codex_run_print_failure_block "$step" "$exit_code" "$reason" "$log_path" "$artifact_path" "$excerpt_text" "$fix" >&2
  fi

  if [ "$codex_run_explain" -eq 1 ]; then
    codex_run_print_final_summary 1 none "$codex_run_summary_path" fail >&2
  fi

  return 1
}

codex_run_main() {
  local arg=""
  local codex_cmd=()
  local resume_prompt_text=""
  local final_output_value="none"
  local summary_value="none"
  local status_value="fail"
  local codex_run_failure_excerpt_block=""

  while [ "$#" -gt 0 ]; do
    arg="$1"
    case "$arg" in
      --help)
        codex_run_usage
        return 0
        ;;
      --quiet)
        codex_run_quiet=1
        ;;
      --explain)
        codex_run_explain=1
        ;;
      --json)
        codex_run_json=1
        ;;
      --resume-session-id=*)
        codex_run_resume_session_id="${arg#--resume-session-id=}"
        if [ -z "$codex_run_resume_session_id" ]; then
          codex_run_flag_value_error "empty flag value" "--resume-session-id" "use --resume-session-id=<id>"
          return 1
        fi
        ;;
      --resume-session-id)
        codex_run_flag_value_error "missing flag value" "--resume-session-id" "use --resume-session-id=<id>"
        return 1
        ;;
      --prompt-file=*)
        codex_run_prompt_file="${arg#--prompt-file=}"
        if [ -z "$codex_run_prompt_file" ]; then
          codex_run_flag_value_error "empty flag value" "--prompt-file" "use --prompt-file=<path>"
          return 1
        fi
        ;;
      --prompt-file)
        codex_run_flag_value_error "missing flag value" "--prompt-file" "use --prompt-file=<path>"
        return 1
        ;;
      --out-dir=*)
        codex_run_out_dir="${arg#--out-dir=}"
        if [ -z "$codex_run_out_dir" ]; then
          codex_run_flag_value_error "empty flag value" "--out-dir" "use --out-dir=<path>"
          return 1
        fi
        ;;
      --out-dir)
        codex_run_flag_value_error "missing flag value" "--out-dir" "use --out-dir=<path>"
        return 1
        ;;
      --profile=*)
        codex_run_profile="${arg#--profile=}"
        if [ -z "$codex_run_profile" ]; then
          codex_run_flag_value_error "empty flag value" "--profile" "use --profile=<name>"
          return 1
        fi
        ;;
      --profile)
        codex_run_flag_value_error "missing flag value" "--profile" "use --profile=<name>"
        return 1
        ;;
      --model=*)
        codex_run_model="${arg#--model=}"
        if [ -z "$codex_run_model" ]; then
          codex_run_flag_value_error "empty flag value" "--model" "use --model=<model-name>"
          return 1
        fi
        if ! codex_run_is_conservative_token "$codex_run_model"; then
          codex_run_flag_value_error "invalid flag value" "--model" "use a conservative model name without spaces, paths, or shell metacharacters"
          return 1
        fi
        ;;
      --model)
        codex_run_flag_value_error "missing flag value" "--model" "use --model=<model-name>"
        return 1
        ;;
      --reasoning=*)
        codex_run_reasoning="${arg#--reasoning=}"
        if [ -z "$codex_run_reasoning" ]; then
          codex_run_flag_value_error "empty flag value" "--reasoning" "use --reasoning=<low|medium|high>"
          return 1
        fi
        if ! codex_run_is_reasoning_level "$codex_run_reasoning"; then
          codex_run_flag_value_error "invalid flag value" "--reasoning" "use --reasoning=low, --reasoning=medium, or --reasoning=high"
          return 1
        fi
        ;;
      --reasoning)
        codex_run_flag_value_error "missing flag value" "--reasoning" "use --reasoning=<low|medium|high>"
        return 1
        ;;
      --cd=*)
        codex_run_cd="${arg#--cd=}"
        if [ -z "$codex_run_cd" ]; then
          codex_run_flag_value_error "empty flag value" "--cd" "use --cd=<path>"
          return 1
        fi
        ;;
      --cd)
        codex_run_flag_value_error "missing flag value" "--cd" "use --cd=<path>"
        return 1
        ;;
      --sandbox=*)
        codex_run_sandbox="${arg#--sandbox=}"
        if [ -z "$codex_run_sandbox" ]; then
          codex_run_flag_value_error "empty flag value" "--sandbox" "use --sandbox=<mode>"
          return 1
        fi
        ;;
      --sandbox)
        codex_run_flag_value_error "missing flag value" "--sandbox" "use --sandbox=<mode>"
        return 1
        ;;
      --timeout=*)
        codex_run_timeout="${arg#--timeout=}"
        if [ -z "$codex_run_timeout" ]; then
          codex_run_flag_value_error "empty flag value" "--timeout" "use --timeout=<seconds>"
          return 1
        fi
        ;;
      --timeout)
        codex_run_flag_value_error "missing flag value" "--timeout" "use --timeout=<seconds>"
        return 1
        ;;
      --*)
        codex_run_fail "unknown flag: $arg" "run repo-automation/bin/codex-run --help"
        return 1
        ;;
      *)
        codex_run_fail "unknown argument: $arg" "run repo-automation/bin/codex-run --help"
        return 1
        ;;
    esac
    shift
  done

  if [ -z "$codex_run_prompt_file" ]; then
    codex_run_fail "missing required --prompt-file" "use --prompt-file=<path> with a readable prompt file"
    return 1
  fi

  if [ -z "$codex_run_out_dir" ]; then
    codex_run_fail "missing required --out-dir" "use --out-dir=<path> for the adapter artifacts"
    return 1
  fi

  if [ "$codex_run_json" -eq 1 ]; then
    if [ "$codex_run_quiet" -eq 1 ]; then
      codex_run_print_quiet_failure "unsupported-json" "output-modes" "JSON output is not implemented yet" "use --quiet or --explain without --json" "" "" "" >&2
    else
      codex_run_flag_value_error "unsupported flag" "--json" "use --quiet or --explain; JSON output is not implemented yet"
    fi
    return 1
  fi

  if [ "$codex_run_quiet" -eq 1 ] && [ "$codex_run_explain" -eq 1 ]; then
    codex_run_print_quiet_failure "output-mode-conflict" "output-modes" "quiet and explain cannot be combined" "use only one output mode" "" "" "" >&2
    return 1
  fi

  if [ ! -e "$codex_run_prompt_file" ]; then
    if [ "$codex_run_quiet" -eq 1 ]; then
      codex_run_print_quiet_failure "missing-prompt-file" "prompt-file" "prompt file does not exist" "provide an existing prompt file" "" "$codex_run_prompt_file" "" >&2
    else
      codex_run_fail "prompt file does not exist: $codex_run_prompt_file" "provide an existing prompt file"
    fi
    return 1
  fi

  if [ -d "$codex_run_prompt_file" ]; then
    if [ "$codex_run_quiet" -eq 1 ]; then
      codex_run_print_quiet_failure "invalid-prompt-file" "prompt-file" "prompt file is a directory" "provide a regular readable prompt file" "" "$codex_run_prompt_file" "" >&2
    else
      codex_run_fail "prompt file is a directory: $codex_run_prompt_file" "provide a regular readable prompt file"
    fi
    return 1
  fi

  if [ ! -f "$codex_run_prompt_file" ]; then
    if [ "$codex_run_quiet" -eq 1 ]; then
      codex_run_print_quiet_failure "invalid-prompt-file" "prompt-file" "prompt file is not a regular file" "provide a regular readable prompt file" "" "$codex_run_prompt_file" "" >&2
    else
      codex_run_fail "prompt file is not a regular file: $codex_run_prompt_file" "provide a regular readable prompt file"
    fi
    return 1
  fi

  if [ ! -r "$codex_run_prompt_file" ]; then
    if [ "$codex_run_quiet" -eq 1 ]; then
      codex_run_print_quiet_failure "unreadable-prompt-file" "prompt-file" "prompt file is not readable" "fix file permissions or choose a readable prompt file" "" "$codex_run_prompt_file" "" >&2
    else
      codex_run_fail "prompt file is not readable: $codex_run_prompt_file" "fix file permissions or choose a readable prompt file"
    fi
    return 1
  fi

  if [ ! -s "$codex_run_prompt_file" ]; then
    if [ "$codex_run_quiet" -eq 1 ]; then
      codex_run_print_quiet_failure "empty-prompt-file" "prompt-file" "prompt file is empty" "provide a non-empty prompt file" "" "$codex_run_prompt_file" "" >&2
    else
      codex_run_fail "prompt file is empty: $codex_run_prompt_file" "provide a non-empty prompt file"
    fi
    return 1
  fi

  if [ -n "$codex_run_resume_session_id" ] && ! codex_run_is_conservative_session_id "$codex_run_resume_session_id"; then
    if [ "$codex_run_quiet" -eq 1 ]; then
      codex_run_print_quiet_failure "invalid-resume-session-id" "resume-session-id" "invalid resume session id" "use a conservative session id without spaces, paths, or shell metacharacters" "" "$codex_run_resume_session_id" "" >&2
    else
      codex_run_fail "invalid resume session id: $codex_run_resume_session_id" "use a conservative session id without spaces, paths, or shell metacharacters"
    fi
    return 1
  fi

  if ! codex_run_is_conservative_token "$codex_run_profile"; then
    if [ "$codex_run_quiet" -eq 1 ]; then
      codex_run_print_quiet_failure "invalid-profile" "profile" "invalid profile" "use a conservative profile name without spaces, paths, or shell metacharacters" "" "$codex_run_profile" "" >&2
    else
      codex_run_fail "invalid profile: $codex_run_profile" "use a conservative profile name without spaces, paths, or shell metacharacters"
    fi
    return 1
  fi

  if ! codex_run_is_conservative_token "$codex_run_sandbox"; then
    if [ "$codex_run_quiet" -eq 1 ]; then
      codex_run_print_quiet_failure "invalid-sandbox" "sandbox" "invalid sandbox" "use a conservative sandbox mode without spaces, paths, or shell metacharacters" "" "$codex_run_sandbox" "" >&2
    else
      codex_run_fail "invalid sandbox: $codex_run_sandbox" "use a conservative sandbox mode without spaces, paths, or shell metacharacters"
    fi
    return 1
  fi

  case "$codex_run_timeout" in
    ''|*[!0-9]*)
      if [ "$codex_run_quiet" -eq 1 ]; then
        codex_run_print_quiet_failure "invalid-timeout" "timeout" "invalid timeout" "use --timeout=<seconds> with a non-negative integer" "" "$codex_run_timeout" "" >&2
      else
        codex_run_fail "invalid timeout: $codex_run_timeout" "use --timeout=<seconds> with a non-negative integer"
      fi
      return 1
      ;;
  esac

  codex_run_repo_root="$(repo_auto_repo_root)" || return 1
  codex_run_out_dir_abs="$(codex_run_resolve_out_dir "$codex_run_out_dir" "$codex_run_repo_root")" || return 1
  if [ ! -d "$codex_run_out_dir_abs" ]; then
    if ! mkdir -p "$codex_run_out_dir_abs"; then
      codex_run_fail "unable to create out-dir: $codex_run_out_dir_abs" "fix filesystem permissions or choose a writable directory outside the current repo root"
      return 1
    fi
  fi

  codex_run_stdout_path="$codex_run_out_dir_abs/codex.stdout"
  codex_run_stderr_path="$codex_run_out_dir_abs/codex.stderr"
  codex_run_final_output_path="$codex_run_out_dir_abs/codex-final.txt"
  codex_run_final_output_block_path="$codex_run_out_dir_abs/codex-final-output-block.txt"
  codex_run_summary_path="$codex_run_out_dir_abs/codex-run-summary.txt"

  codex_run_cd="${codex_run_cd:-$codex_run_repo_root}"
  codex_run_cd_abs="$(codex_run_resolve_existing_dir "$codex_run_cd")" || return 1

  codex_run_codex_path="$(command -v codex 2>/dev/null || true)"
  if [ -z "$codex_run_codex_path" ]; then
    if [ "$codex_run_quiet" -eq 1 ]; then
      codex_run_print_quiet_failure "missing-codex" "codex" "codex command not found on PATH" "install Codex or adjust PATH so repo-automation/bin/codex-run can invoke codex exec" "" "codex" "" >&2
    else
      codex_run_fail "codex command not found on PATH" "install Codex or adjust PATH so repo-automation/bin/codex-run can invoke codex exec"
    fi
    return 1
  fi

  codex_run_timeout_enforced="not_enforced"

  if [ "$codex_run_explain" -eq 1 ]; then
    if [ -n "$codex_run_resume_session_id" ]; then
      printf 'INFO: codex-run requested_profile=%s requested_sandbox=%s timeout=%s\n' \
        "$codex_run_profile" "$codex_run_sandbox" "$codex_run_timeout" >&2
    else
      printf 'INFO: codex-run profile=%s sandbox=%s timeout=%s\n' \
        "$codex_run_profile" "$codex_run_sandbox" "$codex_run_timeout" >&2
    fi
    if [ -n "$codex_run_model" ]; then
      printf 'INFO: codex-run requested_model=%s\n' "$codex_run_model" >&2
    fi
    if [ -n "$codex_run_reasoning" ]; then
      printf 'INFO: codex-run requested_reasoning=%s\n' "$codex_run_reasoning" >&2
    fi
    printf 'INFO: codex-run prompt=%s\n' "$codex_run_prompt_file" >&2
    printf 'INFO: codex-run out-dir=%s\n' "$codex_run_out_dir_abs" >&2
    printf 'INFO: codex-run cd=%s\n' "$codex_run_cd_abs" >&2
    printf 'INFO: codex-run timeout_enforced=%s\n' "$codex_run_timeout_enforced" >&2
  fi

  if [ -n "$codex_run_resume_session_id" ]; then
    resume_prompt_text="$(cat "$codex_run_prompt_file")"
    codex_cmd=(
      "$codex_run_codex_path" exec resume
      "$codex_run_resume_session_id"
      "$resume_prompt_text"
    )
    if [ "$codex_run_explain" -eq 1 ]; then
      printf 'INFO: codex-run executing codex exec resume
' >&2
    fi
    SECONDS=0
    (
      cd "$codex_run_cd_abs" || exit 1
      "${codex_cmd[@]}" >"$codex_run_stdout_path" 2>"$codex_run_stderr_path"
    )
  else
    codex_cmd=("$codex_run_codex_path" exec)
    if [ "$codex_run_profile" != "default" ]; then
      codex_cmd+=("--profile" "$codex_run_profile")
    fi
    if [ -n "$codex_run_model" ]; then
      codex_cmd+=("--model" "$codex_run_model")
    fi
    if [ -n "$codex_run_reasoning" ]; then
      codex_cmd+=("-c" "model_reasoning_effort=$codex_run_reasoning")
    fi
    codex_cmd+=(
      "--cd" "$codex_run_cd_abs"
      "--sandbox" "$codex_run_sandbox"
      "--output-last-message" "$codex_run_final_output_path"
      -
    )

    if [ "$codex_run_explain" -eq 1 ]; then
      printf 'INFO: codex-run executing codex exec
' >&2
    fi
    SECONDS=0
    "${codex_cmd[@]}" < "$codex_run_prompt_file" >"$codex_run_stdout_path" 2>"$codex_run_stderr_path"
  fi
  codex_run_exit_code=$?
  codex_run_elapsed_seconds="$SECONDS"
  codex_run_elapsed_summary="$(codex_run_format_elapsed_summary "$codex_run_elapsed_seconds")"

  if [ "$codex_run_exit_code" -ne 0 ]; then
    codex_run_failure_reason="codex exec exited with status $codex_run_exit_code"
    codex_run_failure_fix="inspect the child failure log and rerun codex-run"
    codex_run_failure_log="$codex_run_stderr_path"
    if [ ! -s "$codex_run_failure_log" ] && [ -s "$codex_run_stdout_path" ]; then
      codex_run_failure_log="$codex_run_stdout_path"
    fi
    codex_run_failure_excerpt="$(codex_run_first_excerpt_line "$codex_run_failure_log")"
    codex_run_failure_excerpt_block="$(codex_run_first_excerpt "$codex_run_failure_log")"
    codex_run_failure_code="codex-child-failed"
    codex_run_failure_artifact=""
    codex_run_result="fail"
    codex_run_failure_step="codex"
    codex_run_write_summary || return 1
    if [ "$codex_run_quiet" -eq 1 ]; then
      codex_run_print_quiet_failure "$codex_run_failure_code" "$codex_run_failure_step" "$codex_run_failure_reason" "$codex_run_failure_fix" "$codex_run_failure_log" "" "$(codex_run_first_excerpt_line "$codex_run_failure_log")" >&2
    else
      codex_run_print_failure_block "$codex_run_failure_step" "$codex_run_exit_code" "$codex_run_failure_reason" "$codex_run_failure_log" "" "$codex_run_failure_excerpt_block" "$codex_run_failure_fix" >&2
    fi
    if [ "$codex_run_explain" -eq 1 ]; then
      codex_run_print_final_summary 1 none "$codex_run_summary_path" fail >&2
    fi
    return 1
  fi

  if [ -n "$codex_run_resume_session_id" ]; then
    cat "$codex_run_stdout_path" > "$codex_run_final_output_path" || return 1
  fi

  if [ -f "$codex_run_final_output_path" ] && [ ! -s "$codex_run_final_output_path" ]; then
    codex_run_final_output_status="empty"
  elif [ -s "$codex_run_final_output_path" ]; then
    codex_run_final_output_status="present"
    final_output_value="$codex_run_final_output_path"
    codex_run_result="pass"
    if ! repo_operator_output_write_file_block "CODEX FINAL OUTPUT" "$codex_run_final_output_path" "$codex_run_final_output_block_path"; then
      codex_run_failure_code="codex-final-output-block-write-failed"
      codex_run_failure_step="final-output-block"
      codex_run_failure_reason="failed to write final output block artifact"
      codex_run_failure_fix="ensure the final output file stays readable while codex-run writes the block artifact"
      codex_run_failure_log="$codex_run_final_output_path"
      codex_run_failure_artifact="$codex_run_final_output_block_path"
      codex_run_failure_excerpt="$codex_run_failure_reason"
      codex_run_result="fail"
      codex_run_write_summary || return 1
      if [ "$codex_run_quiet" -eq 1 ]; then
        codex_run_print_quiet_failure "$codex_run_failure_code" "$codex_run_failure_step" "$codex_run_failure_reason" "$codex_run_failure_fix" "$codex_run_failure_log" "$codex_run_failure_artifact" "$codex_run_failure_reason" >&2
      else
        codex_run_print_failure_block "$codex_run_failure_step" "$codex_run_exit_code" "$codex_run_failure_reason" "$codex_run_failure_log" "$codex_run_failure_artifact" "$codex_run_failure_reason" "$codex_run_failure_fix" >&2
      fi
      if [ "$codex_run_explain" -eq 1 ]; then
        codex_run_print_final_summary 1 none "$codex_run_summary_path" fail >&2
      fi
      return 1
    fi
    codex_run_write_summary || return 1
    if [ "$codex_run_quiet" -eq 0 ] && [ "$codex_run_explain" -eq 0 ]; then
      printf 'pass
'
      printf 'final_output_path=%s
' "$codex_run_final_output_path"
      printf 'summary_path=%s
' "$codex_run_summary_path"
    fi
    if [ "$codex_run_explain" -eq 1 ]; then
      printf 'INFO: codex-run final output=%s
' "$codex_run_final_output_path" >&2
      codex_run_print_final_summary 0 "$codex_run_final_output_path" "$codex_run_summary_path" pass >&2
      printf '
' >&2
      repo_operator_output_emit_file_block "CODEX FINAL OUTPUT" "$codex_run_final_output_path" 0 >&2
    fi
    return 0
  fi

  if [ -n "$codex_run_resume_session_id" ]; then
    codex_run_failure_code="resume-final-output-contract-failed"
    codex_run_failure_step="resume-final-output-contract"
    codex_run_failure_reason="resume mode cannot produce a reliable final-output artifact"
    codex_run_failure_fix="use codex exec for non-resume execution or implement a verified resume final-output capture path"
    codex_run_failure_log=""
    codex_run_failure_artifact="$codex_run_final_output_path"
    codex_run_failure_excerpt="codex exec resume exited 0 but $codex_run_failure_reason"
    codex_run_result="fail"
    codex_run_write_summary || return 1
    if [ "$codex_run_quiet" -eq 1 ]; then
      codex_run_print_quiet_failure "$codex_run_failure_code" "$codex_run_failure_step" "$codex_run_failure_reason" "$codex_run_failure_fix" "" "$codex_run_failure_artifact" "$codex_run_failure_excerpt" >&2
    else
      codex_run_print_failure_block "$codex_run_failure_step" "$codex_run_exit_code" "$codex_run_failure_reason" "" "$codex_run_failure_artifact" "$codex_run_failure_excerpt" "$codex_run_failure_fix" >&2
    fi
    if [ "$codex_run_explain" -eq 1 ]; then
      codex_run_print_final_summary 1 none "$codex_run_summary_path" fail >&2
    fi
    return 1
  fi

  codex_run_failure_code="final-output-contract-failed"
  codex_run_failure_step="final-output-contract"
  if [ "$codex_run_final_output_status" = "empty" ]; then
    codex_run_failure_reason="final output file is empty"
  else
    codex_run_final_output_status="missing"
    codex_run_failure_reason="final output file is missing"
  fi
  codex_run_failure_fix="ensure codex exec writes a non-empty final output file"
  codex_run_failure_log=""
  codex_run_failure_artifact="$codex_run_final_output_path"
  codex_run_failure_excerpt="codex exec exited 0 but $codex_run_failure_reason"
  codex_run_result="fail"
  codex_run_write_summary || return 1
  if [ "$codex_run_quiet" -eq 1 ]; then
    codex_run_print_quiet_failure "$codex_run_failure_code" "$codex_run_failure_step" "$codex_run_failure_reason" "$codex_run_failure_fix" "" "$codex_run_failure_artifact" "$codex_run_failure_excerpt" >&2
  else
    codex_run_print_failure_block "$codex_run_failure_step" "$codex_run_exit_code" "$codex_run_failure_reason" "" "$codex_run_failure_artifact" "$codex_run_failure_excerpt" "$codex_run_failure_fix" >&2
  fi
  if [ "$codex_run_explain" -eq 1 ]; then
    codex_run_print_final_summary 1 none "$codex_run_summary_path" fail >&2
  fi
  return 1
}

codex_run_main "$@"
# repo-automation/bin/codex-run EOF
