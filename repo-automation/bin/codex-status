#!/usr/bin/env bash
# repo-automation/bin/codex-status

set -u
set -o pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
. "$script_dir/../lib/common.sh" || {
  printf 'STOP: failed to source shared library\n' >&2
  return 2 2>/dev/null || exit 2
}

codex_status_mode="all"
codex_status_selector_kind="latest"
codex_status_session_id=""
codex_status_session_file=""
codex_status_repo_root=""
codex_status_pretty=0
codex_status_check_limits=0
codex_status_warn_remaining_at="15"
codex_status_block_remaining_at="7"

codex_status_usage() {
  printf 'Usage: repo-automation/bin/codex-status [--latest|--session-id=<id>|--session-file=<path>] [--repo-root=<dir>] [--session] [--usage] [--limits] [--resume] [--reentry] [--all] [--pretty] [--check-limits] [--warn-remaining-at=<percent>] [--block-remaining-at=<percent>] [--help]\n'
}

codex_status_fail_flag() { repo_auto_flag_error "$1" "$2" "$3" || true; }

codex_status_invalid_flag() {
  codex_status_fail_flag "unsupported flag" "$1" "run repo-automation/bin/codex-status --help"
}

codex_status_main() {
  local arg=""

  while [ "$#" -gt 0 ]; do
    arg="$1"
    case "$arg" in
      --help) codex_status_usage; return 0 ;;
      --pretty) codex_status_pretty=1 ;;
      --check-limits) codex_status_check_limits=1 ;;
      --latest) codex_status_selector_kind="latest" ;;
      --session) codex_status_mode="session" ;;
      --usage) codex_status_mode="usage" ;;
      --limits) codex_status_mode="limits" ;;
      --resume) codex_status_mode="resume" ;;
      --reentry) codex_status_mode="reentry" ;;
      --all) codex_status_mode="all" ;;
      --session-id=*) codex_status_selector_kind="session-id"; codex_status_session_id="${arg#*=}" ;;
      --session-file=*) codex_status_selector_kind="session-file"; codex_status_session_file="${arg#*=}" ;;
      --repo-root=*) codex_status_repo_root="${arg#*=}" ;;
      --warn-remaining-at=*) codex_status_warn_remaining_at="${arg#*=}" ;;
      --block-remaining-at=*) codex_status_block_remaining_at="${arg#*=}" ;;
      --human|--quiet|--all-sessions|--recent=*|--blocker-summary|--warn-at=*|--block-at=*|--strong-warn-at=*)
        codex_status_invalid_flag "$arg"; return 1 ;;
      --*) codex_status_invalid_flag "$arg"; return 1 ;;
      *) codex_status_invalid_flag "$arg"; return 1 ;;
    esac
    shift
  done

  python3 - "$codex_status_mode" "$codex_status_selector_kind" "$codex_status_session_id" "$codex_status_session_file" "$codex_status_repo_root" "$codex_status_pretty" "$codex_status_check_limits" "$codex_status_warn_remaining_at" "$codex_status_block_remaining_at" <<'PY'
import json, os, sys
import re
from pathlib import Path
from datetime import datetime, timezone

mode, skind, sid, sfile, repo_root, pretty, check_limits, warn_at, block_at = sys.argv[1:]
pretty = pretty == '1'
check_limits = check_limits == '1'
warn_at = float(warn_at)
block_at = float(block_at)
codex_home = Path(os.environ.get('CODEX_HOME', str(Path.home()/'.codex'))).expanduser()

def emit(payload, rc=0):
    if pretty:
        s = []
        sess = payload.get('session', {})
        model = payload.get('model', {})
        git = payload.get('git', {})
        ctx = payload.get('context', {})
        limits = payload.get('limits', {})
        tokens = payload.get('tokens', {})
        s.append(f"session: {sess.get('session_id')}")
        source_bits = [v for v in (sess.get('source'), sess.get('originator')) if v not in (None, '')]
        if source_bits:
            s.append(f"source/originator: {'/'.join(source_bits)}")
        s.append(f"model: {model.get('name')}/{model.get('reasoning') or 'unknown'}")
        git_bits = [v for v in (git.get('branch'), git.get('commit')) if v not in (None, '')]
        if git_bits:
            s.append(f"git: {' '.join(git_bits)}")
        if tokens.get('current_total') is not None or tokens.get('cumulative_total') is not None:
            bits = []
            if tokens.get('current_total') is not None:
                bits.append(f"current_total={tokens.get('current_total')}")
            if tokens.get('cumulative_total') is not None:
                bits.append(f"cumulative_total={tokens.get('cumulative_total')}")
            s.append("tokens: " + " ".join(bits))
        if ctx.get('remaining_summary'):
            s.append(f"context: {ctx.get('remaining_summary')}")
        else:
            s.append("context: unknown")
        five = limits.get('five_hour', {})
        weekly = limits.get('weekly', {})
        if five.get('remaining_percent') is not None:
            s.append(f"five_hour_remaining={five.get('remaining_percent')}%")
        if weekly.get('remaining_percent') is not None:
            s.append(f"weekly_remaining={weekly.get('remaining_percent')}%")
        s.append(f"5h: {five.get('state')} weekly: {weekly.get('state')}")
        for line in s: print(line)
    else:
        print(json.dumps(payload, separators=(',', ':')))
    return rc

def session_files(root):
    for p in root.rglob('*.jsonl'):
        yield p

def filename_session_id(path):
    m = re.search(r'[0-9a-fA-F-]{8,}', path.name)
    if m:
        return m.group(0)
    return path.stem

def select_latest(root):
    files = [p for p in session_files(root) if p.is_file()]
    if not files:
        raise FileNotFoundError('no Codex session files found')
    return max(files, key=lambda p: p.stat().st_mtime)

def select_by_id(root, session_id):
    for p in session_files(root):
        if session_id in p.name:
            return p
        try:
            with p.open() as f:
                for line in f:
                    if '"session_meta"' in line and session_id in line:
                        return p
        except Exception:
            pass
    raise FileNotFoundError(f'session id not found: {session_id}')

def parse(path):
    events=[]
    with path.open() as f:
        for ln in f:
            ln=ln.strip()
            if ln: events.append(json.loads(ln))
    return events

def payload_of(event):
    if isinstance(event, dict) and isinstance(event.get('payload'), dict):
        return event['payload']
    return event if isinstance(event, dict) else {}

def first(d,*keys):
    for k in keys:
        if isinstance(d, dict) and d.get(k) not in (None, ''):
            return d[k]
    return None

def nested(d, *keys):
    cur = d
    for key in keys:
        if not isinstance(cur, dict):
            return None
        cur = cur.get(key)
        if cur in (None, ''):
            return None
    return cur

def as_number(v):
    return v if isinstance(v, (int, float)) and not isinstance(v, bool) else None

def token_fields(src):
    if not isinstance(src, dict):
        src = {}
    return {
        'input': first(src, 'input_tokens'),
        'cached_input': first(src, 'cached_input_tokens'),
        'output': first(src, 'output_tokens'),
        'reasoning_output': first(src, 'reasoning_output_tokens'),
        'total': first(src, 'total_tokens', 'token_count', 'total'),
    }

def rate_limit_fields(src):
    if not isinstance(src, dict):
        src = {}
    used_percent = first(src, 'used_percent')
    remaining_percent = first(src, 'remaining_percent')
    if used_percent is None and isinstance(remaining_percent, (int, float)):
        used_percent = 100 - remaining_percent
    if remaining_percent is None and isinstance(used_percent, (int, float)):
        remaining_percent = 100 - used_percent
    return {
        'percent': used_percent,
        'used_percent': used_percent,
        'remaining_percent': remaining_percent,
        'window_minutes': first(src, 'window_minutes'),
    }

if sfile:
    path=Path(sfile).expanduser()
    if not path.is_file():
        print('fail: missing or unreadable session file', file=sys.stderr); sys.exit(1)
elif skind == 'session-id':
    path=select_by_id(codex_home, sid)
else:
    path=select_latest(codex_home)

try:
    events=parse(path)
except Exception as e:
    print(f'fail: unable to parse session file: {e}', file=sys.stderr); sys.exit(1)

meta = next((payload_of(e) for e in events if e.get('type') == 'session_meta'), {})
turn = next((payload_of(e) for e in reversed(events) if e.get('type') == 'turn_context'), {})
token_event = next((payload_of(e) for e in reversed(events) if (e.get('type') == 'event_msg' and payload_of(e).get('type') == 'token_count') or e.get('type') == 'token_count'), {})
token_info = token_event.get('info', token_event)
token_usage_total = first(token_info, 'total_token_usage') or token_event.get('usage', token_event)
token_usage_last = first(token_info, 'last_token_usage')
rate_limits = first(token_event, 'rate_limits') or first(token_info, 'rate_limits') or {}

sidv = first(meta, 'session_id', 'id') or filename_session_id(path)
if sidv == path.stem:
    session_warning = 'session id fell back to filename stem'
else:
    session_warning = None
model_name = first(turn, 'model_name', 'model')
reasoning = first(turn, 'effort') or nested(turn, 'collaboration_mode', 'settings', 'reasoning_effort') or first(turn, 'reasoning')
repo = Path(repo_root).resolve() if repo_root else None
current_total = first(token_usage_last, 'total_tokens')
if current_total is None:
    current_total = first(token_usage_total, 'total_tokens', 'token_count', 'total')
cumulative_total = first(token_usage_total, 'total_tokens', 'token_count', 'total')
ctx_window = first(token_info, 'model_context_window')
if ctx_window is None:
    ctx_window = first(turn, 'model_context_window', 'context_window')
ctx_window_n = as_number(ctx_window)
current_total_n = as_number(current_total)
cumulative_total_n = as_number(cumulative_total)
context_available = ctx_window_n is not None and current_total_n is not None and current_total_n <= ctx_window_n
if context_available:
    remaining = ctx_window_n - current_total_n
    used_percent = current_total_n / ctx_window_n * 100
    remaining_percent = remaining / ctx_window_n * 100
    remaining_summary = f'{int(round(remaining_percent))}% remaining'
else:
    remaining = None
    used_percent = None
    remaining_percent = None
    remaining_summary = 'unknown'
primary_limit = rate_limits.get('primary', {}) if isinstance(rate_limits, dict) else {}
secondary_limit = rate_limits.get('secondary', {}) if isinstance(rate_limits, dict) else {}
five_hour = rate_limit_fields(primary_limit)
weekly = rate_limit_fields(secondary_limit)
if not context_available and ctx_window_n is not None:
    if current_total_n is not None and current_total_n > ctx_window_n:
        context_warning = 'current token total exceeds model context window; current context usage unavailable'
    elif cumulative_total_n is not None and cumulative_total_n > ctx_window_n:
        context_warning = 'cumulative token total exceeds model context window; current context usage unavailable'
    else:
        context_warning = None
else:
    context_warning = None

def limit_state(rem):
    if rem is None: return 'unknown'
    if rem <= block_at: return 'block'
    if rem <= warn_at: return 'warn'
    return 'ok'

five_hour_state = limit_state(five_hour['remaining_percent'])
weekly_state = limit_state(weekly['remaining_percent'])

payload = {
    'schema':'repo-automation-codex-status/v1','ok':True,'status':'ok','generated_at':datetime.now(timezone.utc).isoformat().replace('+00:00','Z'),
    'codex':{'helper':'repo-automation/bin/codex-status','mode':mode,'version':None},
    'selector':{'kind':skind,'session_id':sid or None,'session_file':str(Path(sfile).expanduser()) if sfile else None,'repo_root':str(repo) if repo else None},
    'session':{'session_id':sidv,'source':first(meta,'source'),'originator':first(meta,'originator'),'resumeable':True},
    'git':{
      'repo_root':str(repo) if repo else None,
      'branch':nested(meta, 'git', 'branch') or first(meta,'branch'),
      'commit':nested(meta, 'git', 'commit_hash') or nested(meta, 'git', 'commit') or first(meta,'commit'),
      'repository_url':nested(meta, 'git', 'repository_url') or first(meta,'repository_url'),
    },
    'model':{'name':model_name,'reasoning':reasoning,'context_window':ctx_window},
    'tokens':{
      'total':current_total_n,
      'current_total':current_total_n,
      'last_total':current_total_n,
      'cumulative_total':cumulative_total_n,
      'input':first(token_usage_last,'input_tokens'),
      'cached_input':first(token_usage_last,'cached_input_tokens'),
      'output':first(token_usage_last,'output_tokens'),
      'reasoning_output':first(token_usage_last,'reasoning_output_tokens'),
      'current':token_fields(token_usage_last),
      'cumulative':token_fields(token_usage_total),
    },
    'context':{'remaining':remaining,'used_percent':used_percent,'remaining_percent':remaining_percent,'remaining_summary':remaining_summary},
    'limits':{'five_hour':{**five_hour,'state':five_hour_state,'warn_at':warn_at,'block_at':block_at},'weekly':{**weekly,'state':weekly_state,'warn_at':warn_at,'block_at':block_at}},
    'resume':{'resume_commands':[],'decision_inputs':{'resume_without_compact':'operator_judgment_required','compact_then_resume':'unsupported_or_unproven','resume_and_allow_natural_compact':'operator_judgment_required','start_fresh':'available'}},
    'reentry':{'decision_inputs':{'resume_without_compact':'operator_judgment_required','compact_then_resume':'unsupported_or_unproven','resume_and_allow_natural_compact':'operator_judgment_required','start_fresh':'available'}},
    'warnings':[],'errors':[],'next':[]
}
if sidv:
    payload['resume']['resume_commands']=[f"codex resume --include-non-interactive {sidv}", f'codex exec resume {sidv} "<PROMPT>"']
if payload['model']['reasoning'] in (None, ''):
    payload['model']['reasoning'] = 'unknown'
if session_warning:
    payload['warnings'].append(session_warning)
if context_warning:
    payload['warnings'].append(context_warning)
if current_total_n is not None and cumulative_total_n is not None:
    payload['tokens']['last_total'] = current_total_n

if check_limits and ('block' in (payload['limits']['five_hour']['state'], payload['limits']['weekly']['state'])):
    payload['ok']=False
    payload['status']='block'
    emit(payload, 2)
    sys.exit(2)
if payload['limits']['five_hour']['state']=='warn':
    payload['warnings'].append('five-hour remaining at or below warning threshold')
if payload['limits']['weekly']['state']=='warn':
    payload['warnings'].append('weekly remaining at or below warning threshold')
emit(payload, 0)
PY
}

codex_status_main "$@"
